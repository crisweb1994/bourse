# =============================================================================
# Bourse — minimal env. Designed to get you running in ~2 minutes.
#
# Fastest path (no GitHub OAuth, no signup):
#   1. cp .env.example .env
#   2. paste ONE AI key (Anthropic OR OpenAI-compatible) below
#   3. docker compose --profile app up -d --build
#   4. open http://localhost:3000
#
# For multi-user mode, web search, custom data sources, feature flags,
# planner / hybrid preview / Redis — see `.env.production.example`.
# =============================================================================

# ---- Database (compose default, no edit needed) -----------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/bourse?schema=public"

# ---- Auth -------------------------------------------------------------------
# Single-user / private mode: set to false and skip GitHub OAuth entirely.
# Multi-user public mode: set true and fill GITHUB_* in .env.production.example.
AUTH_REQUIRED="false"

# Used to sign session JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-random-secret"

# Encrypts AI Provider API keys stored in PostgreSQL. Generate independently
# with: openssl rand -base64 32. This key is required when provider keys are
# stored in PostgreSQL; it is intentionally independent from JWT_SECRET.
AI_CREDENTIALS_ENCRYPTION_KEY="change-me-to-an-independent-random-secret"

# ---- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ---- AI provider (pick ONE) -------------------------------------------------
# Option A — Anthropic (Claude)
AI_PROVIDER="claude"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Option B — OpenAI / OpenAI-compatible (DeepSeek, Kimi, 智谱, 通义, 火山方舟…)
# Set AI_PROVIDER="openai" above and uncomment:
# OPENAI_API_KEY=""
# OPENAI_BASE_URL=""          # e.g. https://api.deepseek.com/v1
# OPENAI_MODEL="gpt-4o-mini"

# ---- Research data (optional) ---------------------------------------------
# SEC asks automated clients to identify a contact address. It also powers the
# official US issuer-profile fallback and filings / XBRL connectors.
# Replace contact@example.com with a real, monitored address before serious
# use — SEC may throttle or block clients it cannot contact.
RESEARCH_CORE_USER_AGENT="Bourse research contact@example.com"

# Optional documented market-data APIs. When configured they are tried before
# the key-free public fallbacks; leave blank to preserve zero-config behavior.
TWELVE_DATA_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
EODHD_API_KEY=""

# Optional licensed CN structured data. The manifest declares only these
# explicitly enabled entitlements (comma-separated).
TUSHARE_TOKEN=""
TUSHARE_ENABLED_DATASETS=""
TUSHARE_REQUESTS_PER_MINUTE="60"

# Optional licensed US REST market data. Values must match the purchased plan.
MASSIVE_API_KEY=""
MASSIVE_ENABLED_CAPABILITIES=""
MASSIVE_QUOTE_DELAY=""
MASSIVE_HISTORY_INTERVALS="1d"
MASSIVE_REQUESTS_PER_MINUTE="60"

# Optional: current SFC weekly CSV URL, reviewed against the official site.
SFC_SHORT_POSITION_CSV_URL=""

# Optional global web-search default for self-hosted instances. A user's
# WebSearchSetting takes precedence when configured in the product UI.
WEB_SEARCH_PROVIDER=""
TAVILY_API_KEY=""
